rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTechnician() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'technician';
    }

    function isSubAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sub-admin';
    }

    // Sub-admin access is configurable by the super-admin in
    // config/rolePermissions (Admin Settings → Customize Access by Role).
    // Levels: 'hidden' | 'read' | 'edit'. Missing doc/field fails closed.
    function subAdminLevel(feature) {
      return get(/databases/$(database)/documents/config/rolePermissions).data.visibility[feature].subAdmin;
    }

    function subAdminCanRead(feature) {
      return isSubAdmin() && subAdminLevel(feature) in ['read', 'edit'];
    }

    function subAdminCanEdit(feature) {
      return isSubAdmin() && subAdminLevel(feature) == 'edit';
    }

    // Users collection - sub-admin is platform-wide (Selvacore staff), not
    // scoped to a sub-contractor. Sub-admin can read all users and edit
    // operational users (technician/customer), but cannot create or modify
    // admin/sub-admin records — that's an admin-only identity boundary.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isSubAdmin();
      // A new user creates their own doc on first sign-in. They may only
      // self-assign a non-privileged role (admin/sub-admin stay admin-only).
      allow create: if isAdmin() ||
        (isSubAdmin() &&
         request.resource.data.role != 'admin' &&
         request.resource.data.role != 'sub-admin') ||
        (isOwner(userId) &&
         request.resource.data.role != 'admin' &&
         request.resource.data.role != 'sub-admin');
      // Owners may edit their own doc (profile, role selection customer->
      // technician, applying draft->pending) but may NOT self-assign a
      // privileged role, nor self-approve (set technicianStatus to 'approved'
      // when it wasn't already) — approval is an admin-only action.
      allow update: if isAdmin() ||
        (isSubAdmin() &&
         resource.data.role != 'admin' &&
         resource.data.role != 'sub-admin' &&
         request.resource.data.role != 'admin' &&
         request.resource.data.role != 'sub-admin') ||
        (isOwner(userId) &&
         request.resource.data.get('role', '') != 'admin' &&
         request.resource.data.get('role', '') != 'sub-admin' &&
         (request.resource.data.get('technicianStatus', '') == resource.data.get('technicianStatus', '') ||
          request.resource.data.get('technicianStatus', '') != 'approved'));
      allow delete: if isAdmin() ||
        (isSubAdmin() &&
         resource.data.role != 'admin' &&
         resource.data.role != 'sub-admin');
    }

    // Products collection - public catalog read; admin writes, sub-admin
    // writes when granted 'edit' in config/rolePermissions
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || subAdminCanEdit('featureProducts');
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow write: if isOwner(customerId) || isAdmin();
    }

    // Orders collection - restricted reads, validated creates
    // Sub-admin is platform-wide: sees and manages all orders, but cannot
    // delete (admin-only structural action).
    match /orders/{orderId} {
      allow read: if isAdmin() || isSubAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
        (isTechnician() && (resource.data.status == 'pending' || resource.data.technicianId == request.auth.uid));

      // Only allow create if customerId matches the authenticated user
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid;

      allow update: if isAdmin() || isSubAdmin();
      allow delete: if isAdmin();

      // Customers can update their own orders (rating, cancellation)
      // But cannot modify scheduling fields (admin-only)
      allow update: if isAuthenticated() &&
        resource.data.customerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['scheduledAt', 'estimatedDurationMinutes']);

      // Technicians can update pending orders (accept) or their own assigned orders
      // But cannot modify scheduling fields (admin-only)
      allow update: if isTechnician() &&
        (resource.data.status == 'pending' ||
         resource.data.technicianId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['scheduledAt', 'estimatedDurationMinutes']);
    }

    // Sub-contractors collection - sub-admin reads all (platform-wide visibility);
    // contractor create/edit/delete is admin, or sub-admin when granted 'edit'.
    match /subContractors/{contractorId} {
      allow read: if isAdmin() || isSubAdmin();
      allow write: if isAdmin() || subAdminCanEdit('featureSubContractors');
    }

    // Transactions collection - validated create, admin manage; sub-admin
    // reads/manages when granted in config/rolePermissions
    match /transactions/{transactionId} {
      allow read: if isAdmin() || subAdminCanRead('featureTransactions');
      // Enforce performedBy matches the authenticated user
      allow create: if isAuthenticated() &&
        request.resource.data.performedBy == request.auth.uid;
      allow update, delete: if isAdmin() || subAdminCanEdit('featureTransactions');
    }

    // Services collection - public read; admin writes, sub-admin writes
    // when granted 'edit' in config/rolePermissions
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() || subAdminCanEdit('featureServices');
    }

    // Customer History collection
    match /customerHistory/{historyId} {
      allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Student data
    match /students/{studentId} {
      allow read: if isOwner(studentId);
      allow write: if isOwner(studentId);
    }

    // Lessons
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Problem sets
    match /problemSets/{problemSetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User progress
    match /progress/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Devices collection — registered Ezer units
    // Sub-admin has platform-wide read/update access (operational data),
    // but device deletion stays admin-only.
    match /devices/{deviceId} {
      allow read: if isAdmin() || isSubAdmin() || isTechnician() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isTechnician() &&
        request.resource.data.technicianId == request.auth.uid;
      // Admins/sub-admins can update any field. Technicians can only update the
      // maintenance-denormalization fields written by completeMaintenance().
      allow update: if isAdmin() || isSubAdmin() || (
        isTechnician() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastEzerMaintenanceAt',
          'nextEzerMaintenanceDue',
          'lastFilterReplacementAt',
          'nextFilterReplacementDue'
        ])
      );
      allow delete: if isAdmin();
    }

    // Notifications collection — in-app notifications per user
    match /notifications/{notificationId} {
      // User reads own notifications, admin reads all
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Any authenticated user can create notifications (server-side via Cloud Functions runs as admin)
      allow create: if isAuthenticated();
      // User can update own notification (mark as read), admin can update any
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Reviews collection — customer ratings for orders
    match /reviews/{reviewId} {
      // Customers see non-hidden reviews; technicians see reviews about them; admins + sub-admins see all.
      // `resource == null` allows reading a review doc that doesn't exist yet
      // (the review page reads reviews/{orderId} before the customer submits) —
      // a missing doc leaks nothing.
      allow read: if isAdmin() || isSubAdmin() ||
        (isTechnician() && resource.data.technicianId == request.auth.uid) ||
        (isAuthenticated() && (resource == null || resource.data.hidden == false));

      // Customer can create a review for their own completed order.
      // Document ID must equal orderId — guarantees one review per order.
      // Cross-document get() verifies order status server-side.
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.orderId == request.resource.id &&
        request.resource.data.hidden == false &&
        request.resource.data.flagged == false &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'completed';

      // Customer can edit own review within the server-set edit window.
      // Ownership fields (customerId, orderId, technicianId) are immutable.
      allow update: if isAuthenticated() &&
        resource.data.customerId == request.auth.uid &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.technicianId == resource.data.technicianId &&
        request.time < resource.data.editableUntil;

      // Admin/sub-admin can flag, hide, or modify any review
      allow update: if isAdmin() || isSubAdmin();

      allow delete: if isAdmin();
    }

    // Maintenance Schedules collection
    // Sub-admin has platform-wide read/update access; deletion stays admin-only.
    match /maintenanceSchedules/{scheduleId} {
      allow read: if isAdmin() || isSubAdmin() || isTechnician() || isAuthenticated();
      allow create: if isTechnician() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || isSubAdmin() || isTechnician();
      allow delete: if isAdmin();
    }

    // Maintenance Visits collection
    // Sub-admin has platform-wide read/update access; deletion stays admin-only.
    match /maintenanceVisits/{visitId} {
      allow read: if isAdmin() || isSubAdmin() || isTechnician() || isAuthenticated();
      allow create: if isTechnician();
      allow update: if isAdmin() || isSubAdmin();
      allow delete: if isAdmin();
    }

    // Inventory collection — admin, or sub-admin per config/rolePermissions
    match /inventory/{itemId} {
      allow read: if isAdmin() || subAdminCanRead('featureInventory');
      allow write: if isAdmin() || subAdminCanEdit('featureInventory');
    }

    // Stock Adjustments collection — follows the inventory feature grant
    match /stockAdjustments/{adjustmentId} {
      allow read: if isAdmin() || subAdminCanRead('featureInventory');
      allow write: if isAdmin() || subAdminCanEdit('featureInventory');
    }

    // QR Codes collection — admin only
    match /qrCodes/{qrCodeId} {
      allow read, write: if isAdmin();
    }

    // Mail collection — used by Firebase Trigger Email extension
    // Authenticated users can create emails; extension handles read/delete
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Config collection — app-level configuration documents
    // rolePermissions: UI-level feature visibility per role.
    // Any authenticated user reads (their portal needs to know what to show);
    // only admins write.
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

